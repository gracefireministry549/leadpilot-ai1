# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://nktsdsdmdnhintykjiiu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ivwyjTf8EPmsyqjy6rAh-g_3e3bhZ13
# Optional legacy alias for older deployment setups:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side persistence (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Lead provider (server-side only; never expose the secret to the browser)
LEAD_PROVIDER_API_URL=
LEAD_PROVIDER_API_KEY=

# Optional AI logo generation for Website & Brand Agent
# Without this key LeadPilot uses a deterministic SVG fallback logo.
TOGETHER_API_KEY=

# Optional Google Places upgrade for GBP Audit. Requires a billing-enabled Google Cloud project.
# Without this key the GBP audit uses public directory evidence + website reachability only.
GOOGLE_PLACES_API_KEY=

# Optional email delivery for approval-first outreach. No sends occur without human approval.
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=

# Optional Python agent workforce. TypeScript remains the control plane.
# Point this at the deployed services/python-agents worker URL.
# When unset or unavailable, LeadPilot uses its TypeScript fallback implementations.
PYTHON_AGENT_URL=
PYTHON_AGENT_TIMEOUT_MS=15000

# ---- AI models (server-side secrets; set at least one). Agents fall back in this order. ----
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/keys  (models ending in ":free" cost nothing)
OPENROUTER_API_KEY=
# xAI Grok (paid API): https://console.x.ai
XAI_API_KEY=
# Optional: change the order, e.g. LLM_PROVIDER_ORDER=gemini,groq,openrouter
LLM_PROVIDER_ORDER=
# Optional model overrides. Check each provider's current model list before changing.
GROQ_MODEL=
GEMINI_MODEL=
OPENROUTER_MODEL=
XAI_MODEL=

# ---- Redis cache and rate limiting (Upstash REST; works on Cloudflare Workers) ----
# Create a free database at https://console.upstash.com and copy the REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Agent runs allowed per user per hour (default 30).
AGENT_RATE_LIMIT_PER_HOUR=30
